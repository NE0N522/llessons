NODE_ENV=development
PORT=3000
# Neon pooled endpoint (usually includes -pooler), for application queries.
DATABASE_URL=
# Neon direct endpoint (without -pooler), used only to apply/check schema migrations.
MIGRATIONS_DATABASE_URL=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
TRUST_PROXY=0
SETUP_TOKEN=
ALLOWED_ORIGINS=
PRIVACY_CONTACT=
# Optional: enable signed avatar uploads. The API secret stays on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PGLITE_DIR=./data/pglite
